rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdministrator() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasValidAnnouncementAction() {
      let data = request.resource.data;
      return !data.keys().hasAny(['action'])
        || (data.action is map
          && ((data.action.keys().hasAll(['type', 'title', 'centerID'])
            && data.action.keys().hasOnly(['type', 'title', 'centerID'])
            && data.action.type == 'activity'
            && data.action.title is string
            && data.action.title.size() > 0
            && data.action.centerID is string
            && data.action.centerID.size() > 0)
          || (data.action.keys().hasAll(['type', 'day'])
            && data.action.keys().hasOnly(['type', 'day'])
            && data.action.type == 'calendar'
            && data.action.day is string
            && data.action.day.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'))));
    }

    match /admins/{userID} {
      allow get: if isAuthenticated() && request.auth.uid == userID;
    }

    match /announcements/{announcementID} {
      allow read: if isAuthenticated();
      allow create: if isAdministrator()
        && request.resource.data.keys().hasAll([
          'title', 'body', 'topic', 'authorID', 'publishedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'body', 'topic', 'authorID', 'publishedAt', 'action'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.topic in [
          'general', 'santiago', 'acoruna', 'ferrol', 'lalin',
          'monterroso', 'ourense', 'padron', 'vigo'
        ]
        && hasValidAnnouncementAction()
        && request.resource.data.authorID == request.auth.uid
        && request.resource.data.publishedAt == request.time;
    }

    match /users/{userID}/readAnnouncements/{announcementID} {
      allow read: if isAuthenticated() && request.auth.uid == userID;
      allow create, update: if isAuthenticated()
        && request.auth.uid == userID
        && request.resource.data.keys().hasOnly(['readAt'])
        && request.resource.data.readAt == request.time
        && exists(/databases/$(database)/documents/announcements/$(announcementID));
      allow delete: if isAuthenticated() && request.auth.uid == userID;
    }
  }
}
