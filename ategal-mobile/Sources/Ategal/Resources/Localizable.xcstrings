    "tab-who-we-are" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quen somos"
          }
        }
      }
    },
    "who-we-are-contact-description" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se tes dúbidas ou queres máis información, podes\n• Chamarnos ao teléfono do teu centro\n• Enviar un correo electrónico á administración\n• Preguntar directamente no centro en horario de oficina"
          }
        }
      }
    },
    "who-we-are-description" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ATEGAL é unha asociación sen ánimo de lucro, fundada en 1978, que se dedica a organizar actividades formativas, culturais e de lecer en diversos centros de Galicia. Dirixida a persoas de 55 anos ou máis, a nosa misión é mellorar o benestar persoal, promover a saúde integral e potenciar a calidade de vida das persoas a través da súa participación activa en actividades socio-culturais e a convivencia interxeracional."
          }
        }
      }
    },
    "who-we-are-what-we-do" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que facemos"
          }
        }
      }
    },
    "who-we-are-what-we-do-action" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita a nosa web"
          }
        }
      }
    },
    "who-we-are-what-we-do-description" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrecemos actividades en catro grandes áreas:\n• Cultural (historia da arte, literatura, idiomas…)\n• Ocupacional (Música, tecnoloxía e competencias dixitais…)\n• Saúde e benestar (Ioga, pilates, estimulación cognitiva…)\n• Lecer (Celebracións, visita a exposicións, saídas culturais...)\n\nO noso obxectivo é apostar pola educación e a convivencia para promover a autonomía das persoas e formalas para alcanzar un bo vivir."
          }
        }
      }
    },
    "who-we-are-where" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contactar con nós"
          }
        }
      }
    },
    "who-we-are-where-description" : {
      "localizations" : {
        "gl-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contamos con centros en distintas cidades de Galicia, sendo Santiago de Compostela a nosa sede principal."
          }
        }
      }
    }
  },
